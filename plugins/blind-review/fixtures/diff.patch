 // MintCache: a small LRU cache with optional time-to-live.
 export class MintCache {
-  constructor({ max = 100 } = {}) {
+  constructor({ max = 100, ttl = 0 } = {}) {
     this.max = max;
+    // ttl is in seconds; 0 disables expiry.
+    this.ttl = ttl;
     this.map = new Map();
   }

   get(key) {
-    if (!this.map.has(key)) return undefined;
-    const value = this.map.get(key);
+    const entry = this.map.get(key);
+    if (entry === undefined) return undefined;
+    if (this.ttl > 0 && Date.now() - entry.at > this.ttl) {
+      this.map.delete(key);
+      return undefined;
+    }
     // Re-insert to mark as most recently used.
     this.map.delete(key);
-    this.map.set(key, value);
-    return value;
+    this.map.set(key, entry);
+    return entry.value;
   }

   set(key, value) {
     if (this.map.has(key)) this.map.delete(key);
-    this.map.set(key, value);
+    this.map.set(key, { value, at: Date.now() });
     if (this.map.size > this.max) {
       const oldest = this.map.keys().next().value;
       this.map.delete(oldest);
     }
   }
 }
diff --git a/test/cache.test.mjs b/test/cache.test.mjs

@@ -0,0 +1,9 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { MintCache } from '../src/cache.js';
+
+test('get returns the value before ttl elapses', () => {
+  const cache = new MintCache({ ttl: 60 });
+  cache.set('a', 1);
+  assert.equal(cache.get('a'), 1);
+});
